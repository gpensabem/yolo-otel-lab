{
  "uid": "yolo-otel",
  "title": "YOLO OTel Lab",
  "tags": [
    "yolo",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Visão geral (RED: Rate · Errors · Duration)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requisições/s",
      "description": "Contador yolo.requests → yolo_requests_total. rate() = derivada por segundo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(yolo_requests_total[1m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Taxa de erro",
      "description": "Fração de requisições com status=error (inclui uploads inválidos e erros simulados).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(yolo_requests_total{status=\"error\"}[2m])) / clamp_min(sum(rate(yolo_requests_total[2m])), 1e-9)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Latência p95",
      "description": "Percentil 95 calculado a partir dos buckets do histograma.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(yolo_request_duration_milliseconds_bucket[2m])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 4,
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Em andamento",
      "description": "UpDownCounter yolo.inflight: +1 ao entrar, -1 ao sair.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(yolo_inflight)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 5,
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Objetos detectados",
      "description": "Total de objetos no intervalo de tempo selecionado.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(yolo_detections_total[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 6,
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Latência de detecção (p50 / p95 / p99) — clique nos losangos ◆ para abrir o trace",
      "description": "Os losangos são EXEMPLARES: pontos reais do histograma com o trace_id do request que os gerou.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(yolo_request_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A",
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(yolo_request_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B",
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(yolo_request_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Requisições/s por status",
      "description": "Mesmo contador, quebrado pelo atributo status.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(yolo_requests_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Pipeline YOLO (cada etapa é um span + um ponto no histograma yolo.stage.duration)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tempo médio por etapa (empilhado)",
      "description": "média = rate(_sum) / rate(_count). Empilhado mostra quanto cada etapa pesa no total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage) (rate(yolo_stage_duration_milliseconds_sum[1m])) / sum by (stage) (rate(yolo_stage_duration_milliseconds_count[1m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 60,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "p95 por etapa",
      "description": "Percentil por etapa: sum by (le, stage) mantém os buckets separados por etapa.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(yolo_stage_duration_milliseconds_bucket[1m])))",
          "legendFormat": "{{stage}}",
          "refId": "A",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "heatmap",
      "title": "Distribuição da latência de inferência (heatmap)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cada coluna é um instante; cada faixa é um bucket do histograma.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(yolo_stage_duration_milliseconds_bucket{stage=\"inference\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "ms"
        },
        "color": {
          "scheme": "Oranges",
          "mode": "scheme"
        },
        "cellGap": 1,
        "tooltip": {
          "show": true,
          "yHistogram": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput HTTP (auto-instrumentação FastAPI)",
      "description": "Métricas geradas automaticamente pelo FastAPIInstrumentor — sem nenhuma linha de código nossa.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_target, http_status_code) (rate(http_server_duration_milliseconds_count[1m]))",
          "legendFormat": "{{http_target}} {{http_status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 9
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Detecções",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Objetos/s por classe (top 8)",
      "description": "Contador yolo.detections com atributo class_name.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(8, sum by (class_name) (rate(yolo_detections_total[1m])))",
          "legendFormat": "{{class_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "bargauge",
      "title": "Classes mais detectadas no período",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "increase() no intervalo selecionado, ordenado.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(topk(10, sum by (class_name) (increase(yolo_detections_total[$__range]))))",
          "legendFormat": "{{class_name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": []
      },
      "id": 16,
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 6,
        "h": 9
      }
    },
    {
      "type": "stat",
      "title": "Confiança média",
      "description": "Média da confiança das detecções (histograma yolo.detection.confidence).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(yolo_detection_confidence_sum[5m])) / sum(rate(yolo_detection_confidence_count[5m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
